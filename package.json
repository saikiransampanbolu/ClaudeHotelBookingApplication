{
  "name": "hotel-booking-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "concurrently -n api,ui \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "test": "npm test -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server"
  },
  "devDependencies": { "concurrently": "^9.0.1" }
}
