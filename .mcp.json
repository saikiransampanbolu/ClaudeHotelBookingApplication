{
  "mcpServers": {
    "github": {
      "command": "node",
      "args": ["mcp-github-server.js"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_PAT}",
        "GITHUB_REPO_OWNER": "saikiransampanbolu",
        "GITHUB_REPO_NAME": "ClaudeHotelBookingApplication",
        "GITHUB_BASE_URL": "https://api.github.com"
      },
      "enabled": true,
      "description": "GitHub integration for Hotel Booking repository"
    }
  }
  
}
